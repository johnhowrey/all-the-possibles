# Copy to apps/<app-name>/.env and fill in real values. Expo only exposes
# vars prefixed EXPO_PUBLIC_ to the JS bundle, so every key here keeps that
# prefix. Nothing here is secret in the usual sense (these are all
# client-embedded SDK keys, not server secrets), but they still shouldn't
# be committed — keep real values in keys.txt / your password manager.

# RevenueCat — Project settings > API keys (one per platform)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# PostHog — Project settings > Project API Key
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — Project settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
